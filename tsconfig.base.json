{
    "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "paths": {
            "@lambdas/*": [
                "lambdas/*/src"
            ]
        },
        "outDir": "dist"
    },
    "include": [
        "packages",
        "lambdas"
    ]
}